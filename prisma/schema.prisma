generator client { provider = "prisma-client-js" }
datasource db { provider = "postgresql" url = env("DATABASE_URL") }
enum Role { OWNER ADMIN MANAGER ANALYST }
enum Severity { LOW MEDIUM HIGH CRITICAL }
model Organization { id String @id @default(cuid()) name String slug String @unique createdAt DateTime @default(now()) memberships Membership[] stores Store[] products Product[] settings Json? }
model User { id String @id @default(cuid()) email String @unique name String createdAt DateTime @default(now()) memberships Membership[] }
model Membership { id String @id @default(cuid()) organizationId String userId String role Role @default(ANALYST) createdAt DateTime @default(now()) organization Organization @relation(fields:[organizationId],references:[id],onDelete:Cascade) user User @relation(fields:[userId],references:[id],onDelete:Cascade) @@unique([organizationId,userId]) @@index([organizationId]) }
model Store { id String @id @default(cuid()) organizationId String name String city String latitude Float longitude Float capacity Int status String @default("ACTIVE") createdAt DateTime @default(now()) organization Organization @relation(fields:[organizationId],references:[id],onDelete:Cascade) inventory Inventory[] orders Order[] @@index([organizationId]) }
model Product { id String @id @default(cuid()) organizationId String name String category String price Decimal @db.Decimal(12,2) cost Decimal @db.Decimal(12,2) shelfLifeDays Int reorderThreshold Int targetStock Int createdAt DateTime @default(now()) organization Organization @relation(fields:[organizationId],references:[id],onDelete:Cascade) inventory Inventory[] orders Order[] @@index([organizationId,category]) }
model Inventory { id String @id @default(cuid()) organizationId String storeId String productId String quantity Int reservedQuantity Int @default(0) updatedAt DateTime @updatedAt store Store @relation(fields:[storeId],references:[id],onDelete:Cascade) product Product @relation(fields:[productId],references:[id],onDelete:Cascade) @@unique([organizationId,storeId,productId]) @@index([organizationId]) }
model Order { id String @id @default(cuid()) organizationId String storeId String productId String quantity Int unitPrice Decimal @db.Decimal(12,2) orderedAt DateTime @default(now()) store Store @relation(fields:[storeId],references:[id],onDelete:Cascade) product Product @relation(fields:[productId],references:[id],onDelete:Cascade) @@index([organizationId,orderedAt]) @@index([storeId,productId]) }
